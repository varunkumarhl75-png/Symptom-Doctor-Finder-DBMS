DB_HOST=localhost
DB_PORT=3306
DB_USER=sdf_app
DB_PASSWORD=replace-with-the-generated-sdf_app-password
DB_NAME=symptom_doctor_finder

# Used only by app/create_admin.py; provision a trusted account separately.
# Do not set these to the Flask application's sdf_app credentials.
ADMIN_DB_HOST=localhost
ADMIN_DB_PORT=3306
ADMIN_DB_USER=sdf_admin_creator
ADMIN_DB_PASSWORD=replace-with-the-trusted-admin-creator-password

# Redis is an optional cache; MySQL remains the permanent database.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=300
REDIS_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1

# Generate a random value for your local .env; never commit that file.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Use true only when the Flask site is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8

# Flask development server debugging is off by default.
FLASK_DEBUG=false
